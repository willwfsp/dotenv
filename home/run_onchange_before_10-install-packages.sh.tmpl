#!/bin/bash
# Re-runs whenever .chezmoidata/packages.yaml or the ios flag changes.
set -euo pipefail

eval "$(/opt/homebrew/bin/brew shellenv)"

# A failed package (e.g. an app already in /Applications that Homebrew didn't install) shouldn't
# stop the dotfiles from being applied. Fix it and re-run `make apply`.
brew bundle --file=/dev/stdin <<EOF || echo "WARNING: some packages failed to install, see above." >&2
{{ range .packages.base.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.base.casks -}}
cask {{ . | quote }}
{{ end -}}
{{ if .ios -}}
{{ range .packages.ios.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ end -}}
EOF
